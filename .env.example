# Local PostgreSQL settings for Docker Compose
POSTGRES_DB=sportbridge
POSTGRES_USER=sportbridge
POSTGRES_PASSWORD=sportbridge_dev_password
POSTGRES_PORT=5433

# Prisma connection string for the local database
DATABASE_URL=postgresql://sportbridge:sportbridge_dev_password@localhost:5433/sportbridge?schema=public

# Server-side structured logging
LOG_LEVEL=info
